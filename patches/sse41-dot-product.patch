--- a/pam.h
+++ b/pam.h
@@ -61,6 +61,9 @@
 #else
 #  define SSE_ALIGN
 #endif
+#if defined(__SSE4_1__)
+#include <smmintrin.h>
+#endif
 
 #if defined(__GNUC__) || defined (__llvm__)
 #define ALWAYS_INLINE __attribute__((always_inline)) inline
@@ -201,10 +204,17 @@ inline static float colordifference(f_pixel px, f_pixel py)
     onwhite = _mm_mul_ps(onwhite, onwhite);
     const __m128 max = _mm_add_ps(onwhite, onblack);
 
+#if defined(__SSE4_1__)
+    // sum r,g,b (elements 1,2,3) into lower lane using SSE4.1 dot product
+    const __m128 ones = _mm_set_ps(1.f, 1.f, 1.f, 1.f);
+    // imm8 = 0xE1 -> include lanes 1..3 in the dot, store result to lane 0
+    const __m128 sum = _mm_dp_ps(max, ones, 0xE1);
+#else
     // add rgb, not a
     const __m128 maxhl = _mm_movehl_ps(max, max);
     const __m128 tmp = _mm_add_ps(max, maxhl);
     const __m128 sum = _mm_add_ss(maxhl, _mm_shuffle_ps(tmp, tmp, 1));
+#endif
 
     const float res = _mm_cvtss_f32(sum);
     assert(fabs(res - colordifference_stdc(px,py)) < 0.001);
